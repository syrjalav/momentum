{
  "manifest_version": 3,
  "name": "Momentum Focus Dashboard",
  "version": "1.0.0",
  "description": "A calm, personal new-tab dashboard with a clock, focus timer, search, tasks, notes, and rotating backgrounds.",
  "permissions": ["storage", "alarms", "notifications"],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Momentum Focus Dashboard"
  }
}
